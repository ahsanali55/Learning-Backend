<%- include('../partials/head') %>
  </head>
  <body>
    <%- include('../partials/nav') %>
    
    <main class="container mx-auto mt-8 p-8 bg-white rounded-lg shadow-md">
      <h1 class="text-3xl font-bold mb-8 text-center text-gray-800">Register as a New User</h1>
      
      <form action="/signup" method="POST" class="max-w-md mx-auto">
        
        <% if (typeof errors != undefined && errors && errors.length > 0) { %>
          <div class="mb-6 p-4 border-l-4 border-red-500 bg-red-300 rounded-md">
            <h2 class="text-red-900 font-semibold mb-2">Errors:</h2>
            <ul class="list-disc list-inside text-red-600">
              <% errors.forEach(error => { %>
                <li><%= error %></li>
                <% }); %>
              </ul>
            </div>
            <% } %>

            <!-- Personal Information Section -->
          <div class="mb-6">
          <input
            type="text"
            name="firstName"
            value="<%= typeof oldInput !== undefined ? oldInput.firstName : ''%>"
            placeholder="Enter your first name"
            class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          />
          <input
            type="text"
            name="lastName"
            value="<%= typeof oldInput !== undefined ? oldInput.lastName : '' %>"
            placeholder="Enter your last name"
            class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          />
          <input
            type="email"
            name="email"
            value="<%= typeof oldInput !== undefined ? oldInput.email : '' %>"
            placeholder="test@pop.com"
            class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          />
        </div>

        <!-- Password Section -->
        <div class="mb-6">
          <input
            type="password"
            name="password"
            value="<%= typeof oldInput !== undefined ? oldInput.password : '' %>"
            placeholder="Enter your password"
            class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          />
          <input
            type="password"
            name="confirmPassword"
            value="<%= typeof oldInput !== undefined ? oldInput.confirmPassword : '' %>"
            placeholder="Confirm your password"
            class="w-full px-4 py-2 mb-4 border rounded-md focus:outline-none focus:ring-2 focus:ring-red-500"
            required
          />
        </div>

        <!-- User Type Section -->
        <div class="mb-6 p-4 border rounded-md">
          <p class="font-semibold text-gray-700 mb-3">Account Type:</p>
          <div class="space-y-2">
            <label class="flex items-center">
              <input 
                type="radio" 
                name="userType" 
                value="guest" 
                id="guest" 
                class="mr-2 w-4 h-4" 
                checked="<% oldInput.userType === "guest" %>"
                
              />
              <span class="text-gray-700">Guest</span>
            </label>
            <label class="flex items-center">
              <input 
                type="radio" 
                name="userType" 
                value="host" 
                id="host" 
                class="mr-2 w-4 h-4"
                checked="<% oldInput.userType === "host" %>"
              />
              <span class="text-gray-700">Host</span>
            </label>
          </div>
        </div>

        <!-- Terms & Conditions Section -->
        <div class="mb-6">
          <label class="flex items-center">
            <input 
              type="checkbox" 
              name="terms" 
              id="terms" 
              class="mr-2 w-4 h-4"
              required
            />
            <span class="text-gray-700">I agree to the terms and conditions</span>
          </label>
        </div>

        <!-- Submit Button -->
        <input 
          type="submit" 
          value="Register" 
          class="w-full bg-red-500 text-white py-2 rounded-md hover:bg-red-600 transition duration-300 font-semibold cursor-pointer"
        />
      </form>
    </main>

  </body>
</html>
