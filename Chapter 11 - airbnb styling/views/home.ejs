<%- include('./partials/head') %>
  </head>
    <body class="bg-gray-100 text-gray-900">
    <%- include('./partials/nav') %>
    <main class="container mx-auto px-4">
      <h2 class="text-xl font-semibold mb-4">Here are our registered homes:</h2>
      <ul class="space-y-2">
        <% registerHomes.forEach((home) => { %>
          <li class="p-4 bg-white rounded shadow-sm hover:shadow-md transition-shadow">
            <img src="<%= home.photoUrl %>" alt="<%= home.houseName %>" class="w-full h-48 object-cover rounded mb-3">
            <h3 class="text-lg font-semibold"><%= home.houseName %></h3>
            <p class="text-gray-600 text-sm mb-2"><%= home.location %></p>
            <div class="flex justify-between items-center">
              <span class="text-xl font-bold text-blue-600">$<%= home.price %></span>
              <span class="text-yellow-500">⭐ <%= home.rating %></span>
            </div>
          </li>
        <% }) %>
      </ul>
    </main>
  </body>
</html>
